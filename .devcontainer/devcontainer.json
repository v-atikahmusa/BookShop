	"image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0",
	"features": {
		"ghcr.io/flexwie/devcontainer-features/op:1": {},
		"ghcr.io/devcontainer-config/features/dot-config:4": {},
		"ghcr.io/postfinance/devcontainer-features/dotnet:1": {},
		"ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {},
		"ghcr.io/dotnet/aspire-devcontainer-feature/dotnetaspire:1": {},
		"ghcr.io/wxw-matt/devcontainer-features/script_runner:0": {},
		"ghcr.io/daniellindemann/dev-container-features/dotnet-usersecrets-persistence:0": {}
